@{
    ViewData["Title"] = "Home Page";
}

<section class="home-hero">
    <div>
        <h1 class="home-title">
            <span class="home-title-line">Pick a film.</span>
            <span class="home-title-line">Watch. Review.</span>
        </h1>
        <p class="home-lead">
            Browse the collection, filter by genre or actor, keep track of what you have
            watched and share a short review with everyone else.
        </p>

        <div class="home-actions">
            <a class="btn btn-primary" asp-area="" asp-controller="Film" asp-action="All">Browse films</a>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a class="btn btn-sec" asp-area="" asp-controller="Film" asp-action="WatchedFilms">My watched films</a>
            }
            else
            {
                <a class="btn btn-sec" asp-area="Identity" asp-page="/Account/Register">Create an account</a>
            }
        </div>
    </div>

    <div class="home-screen">
        <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>

            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/Uploads/one.png" alt="Film still">
                </div>
                <div class="carousel-item">
                    <img src="~/Uploads/two.png" alt="Film still">
                </div>
                <div class="carousel-item">
                    <img src="~/Uploads/tree.png" alt="Film still">
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
</section>

<section class="home-steps" aria-labelledby="how-it-works">
    <h2 id="how-it-works">How it works</h2>
    <ol>
        <li class="home-step">
            <span class="home-step-number">1</span>
            <h3>Find a film</h3>
            <p>Search by title or filter the list by genre and actor.</p>
        </li>
        <li class="home-step">
            <span class="home-step-number">2</span>
            <h3>Mark it as watched</h3>
            <p>Press "Watched" and the film is saved to your own list.</p>
        </li>
        <li class="home-step">
            <span class="home-step-number">3</span>
            <h3>Write a review</h3>
            <p>Open the film's details and tell others what you thought.</p>
        </li>
    </ol>
</section>
